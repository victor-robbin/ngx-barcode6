{
  "name": "barcode",
  "version": "1.22.1",
  "description": "Компонент Angular 22 для построения штрихкодов на основе JsBarcode",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-robbin/ngx-barcode6.git"
  },
  "author": {
    "name": "Edgar Giese",
    "email": "edgar@egiese.de"
  },
  "keywords": [
    "Angular",
    "Angular17",
    "Angular18",
    "Angular19",
    "Angular20",
    "Angular21",
    "barcode",
    "jsbarcode",
    "Angular22"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/victor-robbin/ngx-barcode6/issues"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build:lib": "npm run vendor:jsbarcode && ng build ngx-barcode6",
    "pack:release": "npm run build:lib && npm pack ./dist/ngx-barcode6",
    "vendor:jsbarcode": "node scripts/build-jsbarcode.mjs",
    "postinstall": "npm run vendor:jsbarcode",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.0",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "canvas": "^3.2.1",
    "jsdom": "^27.1.0",
    "ng-packagr": "22.2.1",
    "typescript": "6.0.3",
    "vitest": "^4.0.8",
    "jsbarcode": "3.12.3",
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "homepage": "https://github.com/victor-robbin/ngx-barcode6#readme"
}
